# Copy to .env.local for local development.
# Replace placeholders locally; NEVER commit .env.local.

# Gemini API — server-side only
GEMINI_API_KEY=

# TinyFish — use the official credentials/base URL supplied for your account.
# Do not assume ChatGPT's connected TinyFish tools are automatically available to your app.
TINYFISH_API_KEY=
TINYFISH_API_BASE_URL=
RESEARCH_SOURCE_LIMIT=5 # Default source target; maximum supported value is 8.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker / queue configuration
DATABASE_URL=
WORKER_CONCURRENCY=3
JOB_MAX_ATTEMPTS=4
JOB_TIMEOUT_SECONDS=900

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
